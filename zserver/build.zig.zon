.{
    .name = .zserver,
    .version = "0.1.0",
    .fingerprint = 0x3edb244e41e6b5dc,
    .minimum_zig_version = "0.17.0",

    .dependencies = .{
        // Both deps resolve to <repo>/zig_ws/ (one level up from
        // zserver/) so the build is reproducible from a clean checkout
        // at any depth. Provision them with scripts/provision-zig-deps.sh
        // (clones pinned commits); CI and developers run it before
        // building.
        .zfinal = .{
            .path = "../zig_ws/zfinal",
        },
        .zcli = .{
            .path = "../zig_ws/zcli",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
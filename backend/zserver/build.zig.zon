.{
    .name = .zserver,
    .version = "0.1.0",
    .fingerprint = 0x3edb244e41e6b5dc,
    .minimum_zig_version = "0.17.0",

    .dependencies = .{
        // Framework deps via Zig package manager (git URL + content hash).
        // Bump with:
        //   zig fetch 'git+https://github.com/chy3xyz/<repo>?ref=<tag>#<commit>'
        // then paste .url / .hash below (avoid --save: it may write .path by mistake).
        //
        // zfinal v0.28.10 turns the HTTP timeouts into absolute deadlines
        // (`read_header_timeout_ms` 5s, `idle_timeout_ms` 120s) and caps the
        // drained body at 256 KiB (`max_drain_body_bytes`). It also carries
        // the v0.28.9 fixes for the messaging clients, which could not talk
        // to a real broker at all: the NATS client resolved host names with
        // `parseIp4` only (so even its own default "localhost" failed with
        // InvalidCharacter) and its `ping()` ate the message the server sent
        // before the PONG, and the Kafka Fetch request was laid out for API
        // v9 instead of v7, so the broker closed the connection.
        //
        // zfinal v0.28.6 carries the Linux shutdown fix: closing the
        // listener descriptor does not wake a thread that is already
        // blocked in accept() on Linux, so the accept loop never returned
        // and the server never stopped. On SIGTERM with a connection open
        // — the daemon's WebSocket never ends on its own — the process
        // hung until the orchestrator killed it. The shutdown now wakes
        // the accept with a self-connect first.
        //
        // zfinal v0.28.4 carries the shutdown fix: v0.28.3 called
        // `Group.cancel` on the task group that `Server.start` was already
        // awaiting, which trips `assert(!pre_cancel_status.have_awaiter)`
        // and killed the process with "panic: reached unreachable code"
        // whenever SIGTERM arrived while a connection was still open — a
        // WebSocket never ends on its own, so that was the normal case.
        // The server now interrupts the connections it serves and lets the
        // handlers unwind.
        //
        // v0.28.5 is the same library plus the upstream test fix that had
        // been blocking the release pipeline (a half-initialised Context in
        // zfinal's own tests crashed the Linux quality gate); it is the
        // first zfinal tag that goes through the release gate.
        //
        // v0.28.3 carried the response-compression fix: v0.28.2
        // compressed into a fixed 16 KB buffer with `Compress.Raw` (which
        // does not compress at all) and served the truncated stream when a
        // body did not fit, so every response over roughly 16 KB reached
        // the client undecodable.
        .zfinal = .{
            .url = "git+https://github.com/chy3xyz/zfinal?ref=v0.28.10#39b248ad948d4d7a71b8a54e06ad1ea81867a66b",
            .hash = "zfinal-0.28.10-6AOMdei4cQDI1QMGLw7v1N62TS1lqXtWqxaAUOm0k9ur",
        },
        // Tip of v0.2.0 + 2 commits (no matching tag); pin by commit.
        .zcli = .{
            .url = "git+https://github.com/chy3xyz/zcli#3c466eeb4c5c4644e2f96db124235e3e79fd04d5",
            .hash = "zcli-0.2.0-CR5cGSiNAACHeulKURcsDqFP7ce0T4In4oInViqE-Ps2",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}

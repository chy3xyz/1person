.{
    .name = .zserver,
    .version = "0.1.0",
    .fingerprint = 0x3edb244e41e6b5dc,
    .minimum_zig_version = "0.17.0",

    .dependencies = .{
        // Framework deps via Zig package manager (git URL + content hash).
        // Bump with:
        //   zig fetch 'git+https://github.com/chy3xyz/<repo>?ref=<tag>#<commit>'
        // then paste .url / .hash below (avoid --save: it may write .path by mistake).
        //
        // zfinal v0.28.4 carries the shutdown fix: v0.28.3 called
        // `Group.cancel` on the task group that `Server.start` was already
        // awaiting, which trips `assert(!pre_cancel_status.have_awaiter)`
        // and killed the process with "panic: reached unreachable code"
        // whenever SIGTERM arrived while a connection was still open — a
        // WebSocket never ends on its own, so that was the normal case.
        // The server now interrupts the connections it serves and lets the
        // handlers unwind.
        //
        // v0.28.3 carried the response-compression fix: v0.28.2
        // compressed into a fixed 16 KB buffer with `Compress.Raw` (which
        // does not compress at all) and served the truncated stream when a
        // body did not fit, so every response over roughly 16 KB reached
        // the client undecodable.
        .zfinal = .{
            .url = "git+https://github.com/chy3xyz/zfinal?ref=v0.28.4#ecbe1838a3e9a758bfcecd156085b98e20478c25",
            .hash = "zfinal-0.28.4-6AOMdUffcAAB0iH-vzLI8rHqshDfYoqKfhw591dUk11m",
        },
        // Tip of v0.2.0 + 2 commits (no matching tag); pin by commit.
        .zcli = .{
            .url = "git+https://github.com/chy3xyz/zcli#3c466eeb4c5c4644e2f96db124235e3e79fd04d5",
            .hash = "zcli-0.2.0-CR5cGSiNAACHeulKURcsDqFP7ce0T4In4oInViqE-Ps2",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
